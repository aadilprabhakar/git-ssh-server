# Copy to .env and change. .env stays out of git.

# Address and port to publish on. 127.0.0.1 keeps it on this machine only.
BIND_IP=127.0.0.1
SSH_PORT=2222

# Where things live on the host.
REPOS_DIR=./data/repos
HOSTKEYS_DIR=./data/hostkeys
KEYS_DIR=./keys

# Owner of the repos on the host. On Unraid, shares often use 99 (nobody) and 100 (users).
GIT_UID=1000
GIT_GID=1000
RO_UID=1001
